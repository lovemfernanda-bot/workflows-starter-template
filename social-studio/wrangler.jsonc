{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "brancode-social-studio",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	// Reemplaza database_id con el que devuelve: npx wrangler d1 create brancode-social-studio
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "brancode-social-studio",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// En producción la API exige el JWT de Cloudflare Access. Completa estas dos
	// variables (ver README) o la API responderá 503 por seguridad.
	"vars": {
		"ENVIRONMENT": "production",
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"observability": { "enabled": true }
}
